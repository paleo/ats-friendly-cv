{
  "name": "ats-friendly-cv",
  "version": "0.1.0",
  "description": "Generate ATS-friendly CV PDFs from a JSON file, one per job offer and language.",
  "license": "CC0-1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typeonly": "typeonly --bundle dist/types.to.json -s ./types",
    "generate": "npm run typeonly && node src/main.ts",
    "linkedin": "npm run typeonly && node src/linkedin.ts",
    "skill-years": "npm run typeonly && node src/skill-years.ts",
    "test": "npm run typeonly && node --test tests/*.test.ts",
    "typecheck": "tsc -p .",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "workspace": "node scripts/workspace/workspace.mjs"
  },
  "dependencies": {
    "@typeonly/validator": "^1.1.2",
    "marked": "^18.0.14",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@alignfirst/workspace": "^0.36.0",
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.19.0",
    "typeonly": "^1.1.3",
    "typescript": "^7.0.2"
  }
}
